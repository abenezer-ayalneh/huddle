# Copy to .env.local for local dev. Next.js reads env from this app dir.
# Only NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.

# Base URL of the NestJS backend the frontend calls for tokens.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Base URL where BetterAuth is mounted (the API). Defaults to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Public origin of the web app, used to build absolute URLs in link-preview
# (Open Graph / Twitter) metadata. Set to your deployed domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Search Console URL-prefix ownership token. The preferred
# production method is a DNS TXT record for the root domain; see
# docs/RUNBOOK_GOOGLE_DRIVE_OAUTH_ACCESS.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Sentry error tracking. Use the same web-project DSN for the browser
# and Next.js server. No events are emitted while these are blank.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
