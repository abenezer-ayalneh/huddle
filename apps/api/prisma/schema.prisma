// Prisma schema for Huddle (Phase 7: accounts + persistent scheduled rooms).
// The User/Session/Account/Verification models are the shape BetterAuth expects
// (see docs/LIVEKIT_INTEGRATION.md / ARCHITECTURE.md). Room is our own model:
// a managed room now persists in the DB so it survives an API restart and a
// signed-in host can schedule it ahead of time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- BetterAuth core models ---

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  rooms         Room[]
  cloudStorageConnections CloudStorageConnection[]
  recordingRecipients     RecordingRecipient[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// --- Huddle managed rooms (persistent) ---

model Room {
  id             String    @id @default(cuid())
  // Auto-generated Room Code (Meet-style, e.g. abz-mnpq-rfk). URL-safe; also the
  // LiveKit room name. Rooms have no human title — this is their only identity.
  slug           String    @unique
  // When the meeting is scheduled to start; null means "start now".
  scheduledStart DateTime?
  // Per-room secret that authorizes in-call host actions (x-host-key). Returned
  // only to the owner. Kept here so host authority survives an API restart.
  hostKey        String
  hostUserId     String
  host           User        @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  recordings     Recording[]
  remoteControlSessions RemoteControlSession[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("room")
}

// A room-composite recording (Phase 8). One row per egress job. The lifecycle
// (starting → active → completed/failed) is driven by LiveKit Egress webhook
// events; `objectKey` is the file's path in the S3/MinIO bucket.
model Recording {
  id         String    @id @default(cuid())
  // LiveKit egress id; the webhook references the job by this.
  egressId   String    @unique
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // starting | active | completed | failed | aborted
  status     String    @default("starting")
  // Path within the bucket; known at start time from the egress request.
  objectKey  String
  // LiveKit identity of the non-host participant who started this recording via
  // an approved Request to Record (docs/adr/0011). Null when the host started it
  // directly. Authorizes that participant to stop the recording they began.
  startedByIdentity String?
  sizeBytes  BigInt?
  durationMs Int?
  error      String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  // The hard deadline for the temporary MP4 in MinIO. `localDeleteAfter` can
  // become earlier after verified cloud delivery; the metadata row remains.
  localExpiresAt       DateTime?
  localDeleteAfter     DateTime?
  localDeletedAt       DateTime?
  // Captured at Recording start. A Drive connection created later cannot alter
  // this call's consent availability after participants have joined.
  driveShareAvailable  Boolean   @default(false)
  deliveryWarningSentAt DateTime?
  finalWarningSentAt    DateTime?
  delivery              RecordingDelivery?
  recipients            RecordingRecipient[]

  @@index([roomId])
  @@index([localDeleteAfter])
  @@index([localExpiresAt])
  @@map("recording")
}

// A Host's optional external destination. Google Drive is the only provider in
// this release, but the provider discriminator keeps the data boundary ready
// for a future provider without giving the browser any provider credentials.
model CloudStorageConnection {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String   @default("google_drive")
  providerEmail         String?
  encryptedRefreshToken String?
  driveFolderId         String?
  // connected | action_required | disconnected
  status                String   @default("connected")
  disconnectedAt        DateTime?
  // Optional, once per connected destination. A replacement connection gets a
  // fresh explicit choice without re-running a prior account's backfill.
  backfillRequestedAt   DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, provider])
  @@map("cloud_storage_connection")
}

// Durable job and result projection for an MP4's cloud delivery. The worker
// owns the lease fields; resumable session URLs are encrypted before storage.
model RecordingDelivery {
  id                      String    @id @default(cuid())
  recordingId             String    @unique
  recording               Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  provider                String    @default("google_drive")
  // queued | uploading | action_required | delivered | expired_undelivered
  status                  String    @default("queued")
  attempts                Int       @default(0)
  nextAttemptAt           DateTime  @default(now())
  leaseOwner              String?
  leaseUntil              DateTime?
  encryptedUploadSession  String?
  uploadOffsetBytes       BigInt    @default(0)
  driveFileId             String?
  driveUrl                String?
  deliveredAt             DateTime?
  lastError               String?
  actionNotifiedAt        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@map("recording_delivery")
}

// Evidence of a signed-in participant's final consent to receive a particular
// Recording. The email is a snapshot used only for the Drive permission call.
model RecordingRecipient {
  id           String    @id @default(cuid())
  recordingId  String
  recording    Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  consentedAt  DateTime  @default(now())
  // pending | shared | failed
  status       String    @default("pending")
  permissionId String?
  error        String?
  updatedAt    DateTime  @updatedAt

  @@unique([recordingId, userId])
  @@index([recordingId, status])
  @@map("recording_recipient")
}

// Metadata-only audit history for attended Remote Control (docs/adr/0024).
// Runtime authority lives in Redis; this row deliberately stores no input
// events, screenshots, frames, clipboard data, or secret contents.
model RemoteControlSession {
  id                 String    @id @default(cuid())
  roomId             String
  room               Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sharerIdentity     String
  sharerName         String
  controllerIdentity String
  controllerName     String
  agentIdentity      String?
  // requested | active | denied | ended | expired | failed
  status             String    @default("requested")
  startedAt          DateTime?
  endedAt            DateTime?
  renewalDueAt       DateTime?
  endReason          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([roomId, status])
  @@map("remote_control_session")
}
