{
  "name": "huddle",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, browser-based video conferencing on LiveKit.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:web": "pnpm --filter @huddle/web dev",
    "dev:api": "pnpm --filter @huddle/api start:dev",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build"
  }
}
