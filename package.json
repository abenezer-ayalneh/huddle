{
  "name": "huddle",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, browser-based video conferencing on LiveKit.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:web": "pnpm --filter @huddle/web dev",
    "dev:api": "pnpm --filter @huddle/api start:dev",
    "dev:tunnel:web": "node scripts/with-env.mjs .env .env.tunnel.local -- pnpm --filter @huddle/web dev",
    "dev:tunnel:api": "node scripts/with-env.mjs .env .env.tunnel.local -- pnpm --filter @huddle/api start:dev",
    "check:remote-control-lan": "node scripts/remote-control-lan-check.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env --profile dev-egress-fix up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env --profile dev-egress-fix down",
    "infra:tunnel:up": "docker compose -f infra/docker-compose.yml --env-file .env --env-file .env.tunnel.local --profile dev-egress-fix up -d",
    "infra:tunnel:down": "docker compose -f infra/docker-compose.yml --env-file .env --env-file .env.tunnel.local --profile dev-egress-fix down",
    "tunnel:run": "cloudflared tunnel --config ~/.cloudflared/huddle-local.yml run huddle-local",
    "tunnel:validate": "cloudflared tunnel --config ~/.cloudflared/huddle-local.yml ingress validate",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3"
  }
}
