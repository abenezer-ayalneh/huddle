# Copy to .env and fill in real values. Never commit .env.

# --- LiveKit server (self-hosted) ---
# The backend signs tokens with this key/secret pair.
LIVEKIT_API_KEY=devkey
# Generate with: openssl rand -hex 32
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
# Single source of truth for the LiveKit server's keys. docker-compose passes
# this into the livekit container (livekit.yaml has no keys block). Keep it as
# "<LIVEKIT_API_KEY>: <LIVEKIT_API_SECRET>" so the server and backend agree.
LIVEKIT_KEYS=devkey: replace-with-a-long-random-secret

# WebSocket URL of the LiveKit server.
# Local: ws://localhost:7880   |   Prod: wss://your-domain
LIVEKIT_URL=ws://localhost:7880
# Optional browser-facing URL returned in room/token responses. Defaults to
# LIVEKIT_URL. Set this for local Cloudflare Tunnel testing so API admin/egress
# stays local while browsers receive the public WSS hostname.
LIVEKIT_PUBLIC_URL=

# IP that LiveKit advertises to browsers for WebRTC media (ICE).
# REQUIRED for self-hosted LiveKit in Docker: without it the server advertises
# its unreachable container IP and media fails ("could not establish pc
# connection"). Set to your machine's LAN IP — find it with:
#   macOS:  ipconfig getifaddr en0
#   Linux:  hostname -I | awk '{print $1}'
# Works for both same-machine and other devices on the same network.
LIVEKIT_NODE_IP=192.168.1.100

# --- Frontend (Next.js) ---
# Backend base URL the frontend calls for tokens
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public site URL used for link-preview metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Every Next development origin is explicit, including localhost.
NEXT_ALLOWED_DEV_ORIGINS=localhost
# Optional Google Search Console URL-prefix ownership token. This is public
# metadata, not a secret. Prefer the root-domain DNS TXT method in production.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Control Agent downloads are discovered from the public GitHub releases for
# NEXT_PUBLIC_PROJECT_REPOSITORY_URL; no release-channel variables are needed.
# Operator metadata. Required by the production preflight; local development
# can use these illustrative values.
NEXT_PUBLIC_OPERATOR_NAME=Local Huddle operator
NEXT_PUBLIC_OPERATOR_CONTACT_URL=https://example.com/contact
NEXT_PUBLIC_PROJECT_REPOSITORY_URL=https://github.com/example/huddle

# --- Error tracking (Sentry; optional locally) ---
# Create separate Sentry JavaScript/NestJS projects so browser and API issues
# can be owned/released independently. A DSN is a project endpoint, not an API
# auth secret, but do not reuse a DSN outside the intended project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_API_DSN=
# Optional release metadata. Set this to the deployed Git commit SHA.
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Build-only source-map upload settings for the web app. The token is not needed
# at runtime and must never use NEXT_PUBLIC_*.
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_AUTH_TOKEN=

# --- Backend (NestJS) ---
API_PORT=3001
# Allowed CORS origin(s) for the web app. Local HTTP loopback aliases
# (localhost, 127.0.0.1, and ::1) on the same port are allowed automatically.
# For other setups, use a comma-separated list of exact origins.
WEB_ORIGIN=http://localhost:3000

# --- Redis (used by LiveKit) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Postgres (accounts + persistent scheduled rooms — Phase 7) ---
# docker-compose interpolates these for the postgres container; the API reads
# DATABASE_URL (Prisma). Keep the three parts in sync with DATABASE_URL.
POSTGRES_USER=huddle
POSTGRES_PASSWORD=huddle
POSTGRES_DB=huddle
# Prisma connection string used by apps/api.
DATABASE_URL=postgresql://huddle:huddle@localhost:5432/huddle?schema=public

# --- Auth (BetterAuth — Phase 7) ---
# Secret used to sign sessions. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL of the API where BetterAuth is mounted (used for OAuth callbacks).
BETTER_AUTH_URL=http://localhost:3001
# Exposed to the browser so the auth client knows where the API lives.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Login uses local email + password by default (no extra config needed).
# Google OAuth is optional; set both to enable the "Continue with Google" button.
# (https://console.cloud.google.com → Credentials → OAuth client).
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Separate callback for the optional Drive destination (not the Google sign-in
# callback above). It must exactly match the URI registered in Google Cloud.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/storage-connections/google-drive/callback
# Base64-encoded 32-byte AES key for encrypted Drive refresh tokens and resumable
# upload session URLs. Generate: openssl rand -base64 32. Required to connect Drive.
CLOUD_CREDENTIALS_ENCRYPTION_KEY=
# Optional dedicated HMAC secret for the opaque account proof in participant
# tokens. If blank, LIVEKIT_API_SECRET is used for backward-compatible binding.
PARTICIPANT_ACCOUNT_BINDING_SECRET=

# Email verification is required for local signups. Verification and password
# setup/recovery links are sent over SMTP when SMTP_HOST is set; otherwise no
# email is sent (the links are credentials and are never logged). So SMTP is
# required for email/password signup and Google-only password setup.
# Local Mailpit starts with pnpm infra:up; read emails at http://localhost:8025.
# It captures mail locally without sending to real recipients. For production,
# configure your SMTP provider; see "Email (SMTP)" in docs/DEPLOYMENT.md.
SMTP_HOST=localhost
# Mailpit uses 1025; providers typically use 587 (STARTTLS) or 465 (implicit TLS).
SMTP_PORT=1025
# Mailpit requires no credentials. Production: your provider's SMTP username.
SMTP_USER=
# Production: your provider's SMTP password/key.
SMTP_PASS=
# From address on auth emails, recording notices, and invitations (defaults to SMTP_USER if unset). The
# email's sender display name is "Huddle"; this address must be on a domain
# you've authenticated in the provider (SPF/DKIM) for deliverability.
SMTP_FROM=no-reply@huddle.local

# --- Recording storage (MinIO / S3 — Phase 8) ---
# MinIO root credentials (docker-compose passes these to the minio container).
MINIO_ROOT_USER=huddle
MINIO_ROOT_PASSWORD=huddlehuddle
# S3 bucket recordings are written to (the API creates it if missing).
S3_BUCKET=huddle-recordings
S3_REGION=us-east-1
# Access keys the API and Egress use to read/write MinIO. These MUST equal the
# MinIO root credentials above — nothing provisions a separate scoped user, so a
# mismatch fails every recording with MinIO's "SignatureDoesNotMatch" at upload.
S3_ACCESS_KEY=huddle
S3_SECRET_KEY=huddlehuddle
# Endpoint the API uses to read recordings back (host-facing).
S3_ENDPOINT=http://localhost:9000
# Endpoint LiveKit Egress uses to upload (resolved inside the docker network).
# Handed to Egress per-request, so it must be reachable from the egress
# container — i.e. the minio compose service name, not localhost.
S3_ENDPOINT_INTERNAL=http://minio:9000

# Secret used to HMAC-sign short-lived recording download URLs (docs/adr/0022),
# so the host's browser downloads a finished recording natively (with its own
# progress bar) without sending the host-key header. Generate with:
#   openssl rand -hex 32
# REQUIRED — the API won't start without it.
RECORDING_DOWNLOAD_SECRET=replace-with-a-long-random-secret
# Local MP4 retention: a hard cap from recording completion, then the shorter
# safety copy after verified Drive delivery. Worker is intentionally single-
# concurrency; its PostgreSQL leases make restart/takeover safe.
RECORDING_LOCAL_RETENTION_HOURS=168
RECORDING_DELIVERED_RETENTION_HOURS=24
RECORDING_WORKER_POLL_MS=30000

# Stable ID of the verified owner account in THIS environment; blank denies admin access.
MAINTENANCE_OWNER_USER_ID=
# Optional server-only API URL used by Next.js maintenance checks.
# Production Compose sets this to http://api:3001.
MAINTENANCE_API_INTERNAL_URL=

# Meeting-chat attachments use a separate private bucket and expire after 24h.
# Must differ from S3_BUCKET. Credentials above need multipart + lifecycle rights.
S3_CHAT_BUCKET=huddle-chat
# Provider multipart ceiling in bytes. Default = 10,000 parts x 5 GiB (48.8 TiB).
# Set lower if your S3-compatible provider has a lower object-size limit.
CHAT_FILE_MAX_BYTES=53687091200000
