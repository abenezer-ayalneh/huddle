# Copy to .env and fill in real values. Never commit .env.

# --- LiveKit server (self-hosted) ---
# The backend signs tokens with this key/secret pair.
LIVEKIT_API_KEY=devkey
# Generate with: openssl rand -hex 32
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
# Single source of truth for the LiveKit server's keys. docker-compose passes
# this into the livekit container (livekit.yaml has no keys block). Keep it as
# "<LIVEKIT_API_KEY>: <LIVEKIT_API_SECRET>" so the server and backend agree.
LIVEKIT_KEYS=devkey: replace-with-a-long-random-secret

# WebSocket URL of the LiveKit server.
# Local: ws://localhost:7880   |   Prod: wss://your-domain
LIVEKIT_URL=ws://localhost:7880

# --- Frontend (Next.js) ---
# Public LiveKit URL exposed to the browser. NEVER put the secret here.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Backend base URL the frontend calls for tokens
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Backend (NestJS) ---
API_PORT=3001
# Allowed CORS origin(s) for the web app
WEB_ORIGIN=http://localhost:3000

# --- Redis (used by LiveKit) ---
REDIS_HOST=localhost
REDIS_PORT=6379
