# Production env template (Phase 9 — single-VPS deploy).
# Copy to .env.prod at the repo root and fill in real values. NEVER commit it.
#
# Bring the prod stack up with:
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml \
#     --env-file .env.prod up -d --build
#
# Key difference from dev (.env.example): every service talks over the Docker
# network by SERVICE NAME (postgres/redis/minio/livekit/api/web), and the public
# URLs are https/wss on your real domains behind Caddy.

# --- Public domains (Caddy routes these; ACME issues their certs) ---
ACME_EMAIL=you@example.com
APP_DOMAIN=app.example.com        # Next.js frontend
API_DOMAIN=api.example.com        # NestJS API
LIVEKIT_DOMAIN=livekit.example.com # LiveKit signal / WSS

# --- LiveKit server (self-hosted) ---
LIVEKIT_API_KEY=devkey
# Generate with: openssl rand -hex 32  (must match livekit.prod.yaml webhook.api_key)
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
LIVEKIT_KEYS=devkey: replace-with-a-long-random-secret
# Public WSS URL of the LiveKit server (through Caddy).
LIVEKIT_URL=wss://livekit.example.com
# Usually unnecessary in prod: livekit.prod.yaml sets use_external_ip so LiveKit
# auto-detects the host's public IP. Set only if auto-detection is wrong.
# LIVEKIT_NODE_IP=

# --- Frontend (Next.js) — baked into the browser bundle at build time ---
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# --- Ports ---
# Two layers, don't conflate them:
#   *_PORT      = the port a service LISTENS on INSIDE its container.
#   *_HOST_PORT = the port published on the VPS's 127.0.0.1 that Caddy proxies to.
# The compose maps "127.0.0.1:${*_HOST_PORT}:${*_PORT}" (host:container). Change
# the HOST ports if something else on the box already owns 3001/3002; the
# container ports can stay at their defaults (they never clash — they're inside
# the Docker network). Keep huddle.caddy's upstreams in sync with the HOST ports.
WEB_PORT=3000        # Next.js listen port (inside the container)
WEB_HOST_PORT=3001   # published host port Caddy -> APP_DOMAIN proxies to
API_PORT=3001        # NestJS listen port (inside the container)
API_HOST_PORT=3002   # published host port Caddy -> API_DOMAIN proxies to

# --- Backend (NestJS) ---
# CORS origin = the public frontend URL.
WEB_ORIGIN=https://app.example.com
# Structured JSON logs in prod (also set in the compose override).
LOG_FORMAT=json

# --- Redis (knock state + LiveKit) — reached by service name ---
REDIS_URL=redis://redis:6379

# --- Postgres (accounts + scheduled rooms) — reached by service name ---
POSTGRES_USER=huddle
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=huddle
DATABASE_URL=postgresql://huddle:replace-with-a-strong-password@postgres:5432/huddle?schema=public

# --- Auth (BetterAuth) ---
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://api.example.com
NEXT_PUBLIC_AUTH_URL=https://api.example.com
# Optional Google OAuth. Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Recording storage (MinIO / S3) ---
MINIO_ROOT_USER=huddle
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
S3_BUCKET=huddle-recordings
S3_REGION=us-east-1
# Use a scoped key pair in prod (not the root creds) if you can.
S3_ACCESS_KEY=huddle
S3_SECRET_KEY=replace-with-a-strong-password
# Both endpoints are the in-network service name now: the API runs as a
# container, so it reads recordings via minio:9000 too (no host-facing
# localhost:9000 like dev). Don't swap these — see docs/adr/0003.
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_INTERNAL=http://minio:9000
