# Production env template (Phase 9 — single-VPS deploy).
# Copy to .env.prod at the repo root and fill in real values. NEVER commit it.
#
# Bring the prod stack up with:
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml \
#     --env-file .env.prod up -d --build
#
# Key difference from dev (.env.example): every service talks over the Docker
# network by SERVICE NAME (postgres/redis/minio/livekit/api/web), and the public
# URLs are https/wss on your real domains behind Caddy.

# --- Public domains (Caddy routes these; ACME issues their certs) ---
ACME_EMAIL=you@example.com
APP_DOMAIN=app.example.com        # Next.js frontend
API_DOMAIN=api.example.com        # NestJS API
LIVEKIT_DOMAIN=livekit.example.com # LiveKit signal / WSS

# --- LiveKit server (self-hosted) ---
LIVEKIT_API_KEY=devkey
# Generate with: openssl rand -hex 32. Compose also uses this key id for webhooks.
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
LIVEKIT_KEYS=devkey: replace-with-a-long-random-secret
# Production Compose derives an internal `LIVEKIT_URL=ws://livekit:7880` for
# API/Egress and a browser-facing `LIVEKIT_PUBLIC_URL` from LIVEKIT_DOMAIN.
# LiveKit auto-detects the public IP. Set a node IP only if that is wrong.
# LIVEKIT_NODE_IP=

# Public web/API/auth/LiveKit URLs are derived from the three domains above by
# production Compose. Do not set duplicate NEXT_PUBLIC_* URL variables here.
# Operator identity is required so a self-hosted deployment never accidentally
# claims to be the official Huddle instance.
OPERATOR_NAME=Example Operator
OPERATOR_CONTACT_URL=https://example.com/contact
PROJECT_REPOSITORY_URL=https://github.com/example/huddle
# Optional signed Control Agent distribution. Set all four values or leave all
# blank; incomplete configuration disables downloads.
CONTROL_AGENT_RELEASE_CHANNEL_URL=
CONTROL_AGENT_RELEASES_URL=
CONTROL_AGENT_ISSUES_URL=
CONTROL_AGENT_UPDATE_PUBLIC_KEY=
# Optional embedded TURN/TLS. When true, TURN_DOMAIN and the two files below
# are required before deployment. The default is disabled.
TURN_ENABLED=false
TURN_DOMAIN=
TURN_CERT_FILE=infra/turn-certs/cert.pem
TURN_KEY_FILE=infra/turn-certs/key.pem
# Optional Google Search Console URL-prefix ownership token. This is public
# metadata, not a secret. Prefer a DNS TXT record for the root domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Error tracking (Sentry) ---
# Use separate Sentry projects for the web app and API. NEXT_PUBLIC_SENTRY_DSN
# is baked into the browser bundle; SENTRY_WEB_DSN covers Next.js server/edge
# errors; SENTRY_API_DSN covers NestJS. DSNs are project endpoints, not account
# auth tokens.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_API_DSN=
SENTRY_ENVIRONMENT=production
# Set to the deployed Git commit SHA so issues correlate with releases.
SENTRY_RELEASE=
# Source-map uploads are build-only. Compose gives this token to the web build
# through a BuildKit secret mount and explicitly removes it from the API runtime.
# Keep .env.prod gitignored and never expose the token through NEXT_PUBLIC_*.
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_AUTH_TOKEN=

# --- Ports ---
# Two layers, don't conflate them:
#   *_PORT      = the port a service LISTENS on INSIDE its container.
#   *_HOST_PORT = the port published on the VPS's 127.0.0.1 that Caddy proxies to.
# The compose maps "127.0.0.1:${*_HOST_PORT}:${*_PORT}" (host:container). Change
# the HOST ports if something else on the box already owns 3001/3002; the
# container ports can stay at their defaults (they never clash — they're inside
# the Docker network).
WEB_PORT=3000        # Next.js listen port (inside the container)
WEB_HOST_PORT=3001   # published host port Caddy -> APP_DOMAIN proxies to
API_PORT=3001        # NestJS listen port (inside the container)
API_HOST_PORT=3002   # published host port Caddy -> API_DOMAIN proxies to

# --- Backend (NestJS) ---
# WEB_ORIGIN is derived from APP_DOMAIN in production Compose.
# Structured JSON logs in prod (also set in the compose override).
LOG_FORMAT=json

# --- Redis (knock state + LiveKit) — reached by service name ---
REDIS_URL=redis://redis:6379

# --- Postgres (accounts + scheduled rooms) — reached by service name ---
POSTGRES_USER=huddle
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=huddle
DATABASE_URL=postgresql://huddle:replace-with-a-strong-password@postgres:5432/huddle?schema=public

# --- Auth (BetterAuth) ---
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# BETTER_AUTH_URL is derived from API_DOMAIN in production Compose.
# Optional Google OAuth. Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Separate OAuth callback for a Host's optional Drive delivery destination.
# Register this exact value in Google Cloud; it is not the BetterAuth sign-in URI.
# GOOGLE_DRIVE_REDIRECT_URI is derived from API_DOMAIN in production Compose.
# Generate with `openssl rand -base64 32`; required before anyone can connect Drive.
CLOUD_CREDENTIALS_ENCRYPTION_KEY=
# Optional dedicated HMAC secret for opaque participant account binding.
PARTICIPANT_ACCOUNT_BINDING_SECRET=

# Email verification (REQUIRED in production). The signup confirmation link is
# sent over SMTP; if SMTP_HOST is blank the API sends nothing and never logs the
# link, so no one can complete an email/password signup. Use any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- Recording storage (MinIO / S3) ---
# MinIO is created with ONLY these root credentials (see infra/docker-compose.yml).
# Nothing in the stack provisions a separate scoped S3 user, so the API's
# S3_ACCESS_KEY / S3_SECRET_KEY MUST equal the root pair below, byte-for-byte.
# A mismatch makes every recording fail at upload with MinIO's "SignatureDoesNotMatch".
MINIO_ROOT_USER=huddle
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
S3_BUCKET=huddle-recordings
S3_REGION=us-east-1
# Keep these identical to MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above. (Using a
# narrower scoped key would need an `mc admin user add` provisioning step that
# this stack does not have — don't diverge them without adding one first.)
S3_ACCESS_KEY=huddle
S3_SECRET_KEY=replace-with-a-strong-password
# Both endpoints are the in-network service name now: the API runs as a
# container, so it reads recordings via minio:9000 too (no host-facing
# localhost:9000 like dev). Don't swap these — see docs/adr/0003.
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_INTERNAL=http://minio:9000

# Signs short-lived recording download URLs (docs/adr/0022) so finished
# recordings download natively in the browser (progress bar) without the
# host-key header. Generate with: openssl rand -hex 32. REQUIRED.
RECORDING_DOWNLOAD_SECRET=replace-with-a-long-random-secret
RECORDING_LOCAL_RETENTION_HOURS=168
RECORDING_DELIVERED_RETENTION_HOURS=24
RECORDING_WORKER_POLL_MS=30000
