# Caddy front door for the production deploy (Phase 9). Terminates TLS
# (automatic Let's Encrypt) and reverse-proxies to the web app, API, and the
# LiveKit signal/WSS endpoint. WebRTC media (UDP) and TURN do NOT pass through
# Caddy — they hit the LiveKit container directly (see docs/adr/0004).
#
# Domains + ACME email come from the prod env (.env.prod). Caddy proxies
# WebSocket upgrades automatically, so the LiveKit signal connection just works.

{
	email {$ACME_EMAIL}
}

# Frontend (Next.js)
{$APP_DOMAIN} {
	reverse_proxy web:3000
}

# API (NestJS) — REST + BetterAuth + LiveKit webhook
{$API_DOMAIN} {
	reverse_proxy api:3001
}

# LiveKit signal / WSS. Media and TURN bypass this and reach LiveKit directly.
{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}
