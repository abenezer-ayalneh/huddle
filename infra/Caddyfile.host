# Caddyfile for a HOST-INSTALLED Caddy (not the containerized `caddy` service).
# Copy the relevant blocks into /etc/caddy/Caddyfile and `sudo systemctl reload
# caddy`. The Huddle containers publish web/api on 127.0.0.1 and LiveKit signal
# on :7880, which this host Caddy reverse-proxies (TLS auto-issued per site).
#
# WebRTC media (UDP) and TURN do NOT go through Caddy — they hit LiveKit directly.
# Swap the hostnames below for your own.

# Frontend (Next.js)
huddle.abenezer-ayalneh.dev {
	reverse_proxy 127.0.0.1:3000
}

# API (NestJS) — REST + BetterAuth + LiveKit webhook
huddle-api.abenezer-ayalneh.dev {
	reverse_proxy 127.0.0.1:3001
}

# LiveKit signal / WSS (media + TURN bypass this)
huddle-livekit.abenezer-ayalneh.dev {
	reverse_proxy 127.0.0.1:7880
}
