# Huddle site blocks for a HOST-INSTALLED Caddy that imports /etc/caddy/sites/*.
#
# Keep this file in the repo (infra/) and symlink it into the sites dir so a
# `git pull` keeps Caddy in sync:
#
#   sudo ln -s "$PWD/infra/huddle.caddy" /etc/caddy/sites/huddle.caddy
#   sudo systemctl reload caddy
#
# Requires your main /etc/caddy/Caddyfile to import the dir, e.g.:
#   import /etc/caddy/sites/*
#
# Ports match infra/docker-compose.prod.yml, which publishes the containers on
# localhost: web -> 127.0.0.1:3001, api -> 127.0.0.1:3002, livekit signal :7880.
# WebRTC media (UDP) and TURN do NOT pass through Caddy — they hit LiveKit
# directly (see docs/adr/0004). Caddy auto-issues Let's Encrypt certs for these
# three HTTP/WSS hostnames; it upgrades the LiveKit WebSocket automatically.
#
# Swap the hostnames below for your own if different.

# Frontend (Next.js)
huddle.abenezer-ayalneh.dev {
	reverse_proxy 127.0.0.1:3001
}

# API (NestJS) — REST + BetterAuth + LiveKit webhook
huddle-api.abenezer-ayalneh.dev {
	reverse_proxy 127.0.0.1:3002
}

# LiveKit signal / WSS. Media + TURN bypass this and reach LiveKit directly.
huddle-livekit.abenezer-ayalneh.dev {
	reverse_proxy 127.0.0.1:7880
}
