# Copy to .env.tunnel.local for Cloudflare Tunnel LAN testing.
# These values intentionally override only public/browser-facing origins. Keep
# your secrets and local infrastructure settings in .env.

WEB_ORIGIN=https://local-huddle.abenezer-ayalneh.dev
BETTER_AUTH_URL=https://local-huddle-api.abenezer-ayalneh.dev

NEXT_PUBLIC_API_URL=https://local-huddle-api.abenezer-ayalneh.dev
NEXT_PUBLIC_AUTH_URL=https://local-huddle-api.abenezer-ayalneh.dev
NEXT_PUBLIC_LIVEKIT_URL=wss://local-huddle-livekit.abenezer-ayalneh.dev
NEXT_PUBLIC_SITE_URL=https://local-huddle.abenezer-ayalneh.dev

# Browser-facing LiveKit URL returned by the API in room/token responses.
# LIVEKIT_URL in .env stays ws://localhost:7880 for server-side admin/egress.
LIVEKIT_PUBLIC_URL=wss://local-huddle-livekit.abenezer-ayalneh.dev
